# macOS target (react-native-macos) — generated by
# react-native-macos-init, then adapted by hand. Expo prebuild has no
# macOS target and must never regenerate this folder.
#
# This flag marks every process spawned by THIS Podfile's
# `pod install` (the `react-native config` autolinking call and the
# codegen script) as belonging to the Mac build. The project's
# react-native.config.js checks it and, only for this install,
# excludes react-native-screens and FBReactNativeSpec from
# Apple-platform autolinking/codegen: screens' podspec has no macOS
# platform (it can never link here) and its current Fabric specs use
# syntax the react-native-macos 0.83 codegen parser rejects, which
# otherwise aborts `pod install`; FBReactNativeSpec is the RN 0.86
# core spec set (the fork ships its own). The iOS Podfile does not
# set this flag, so iOS codegen/autolinking are completely
# unaffected. See react-native.config.js for the full explanation.
ENV['HUGBUG_MACOS_POD_INSTALL'] = '1'

require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

# Expo modules autolinking (defines use_expo_modules!). Required —
# see the note inside the target below.
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")

prepare_react_native_project!

target 'hugbug-games-macOS' do
  platform :macos, '14.0'

  # Dynamic frameworks — REQUIRED by react-native-firebase on this
  # target. RNFBApp / RNFBAuth / RNFBCrashlytics resolve
  # firebase-ios-sdk through React Native's SPM integration
  # (spm_dependency); firebase-ios-sdk's Swift Package products are
  # automatic libraries, so under static pod linkage every RNFB pod
  # embeds its own copy of Firebase and they collide at link time as
  # duplicate symbols. RNFB therefore validates linkage in its
  # post_install hook (firebase_spm.rb,
  # rnfirebase_fail_if_spm_static_linkage!) and aborts `pod install`
  # with "[react-native-firebase] SPM + static linkage is not
  # supported" — exactly what macOS run #2 (head da23933, the first
  # run past the worklets fix) hit after "Generating Pods project":
  # this hand-maintained Podfile had no use_frameworks! at all, so
  # CocoaPods defaulted the target to static libraries. The durable
  # fix is the one RNFB's own error prescribes, below. It matches the
  # iOS install, which has been dynamic all along via
  # expo-build-properties' ios.useFrameworks: "dynamic" (app.json) ->
  # ios/Podfile.properties.json -> the generated ios/Podfile; this
  # Podfile is committed and hand-maintained (Expo prebuild never
  # regenerates the macos/ folder), so the line lives here directly.
  # Scoped to this target in this Podfile only — ios/Podfile and its
  # properties file are generated separately and are untouched.
  use_frameworks! :linkage => :dynamic

  # Expo modules MUST be wired with use_expo_modules! (Microsoft's
  # react-native-macos "Install Expo modules" guide; same pattern as
  # ios/Podfile). This rollout originally omitted it, assuming the
  # Expo pods' absence was a harmless warning — it is not:
  # use_native_modules! still autolinks the umbrella `expo` package
  # (the RN CLI config lists it, falling back to its ios config), but
  # Expo.podspec only declares its ExpoModulesCore / ExpoModulesJSI
  # dependencies when use_expo_modules! is defined — without it those
  # pods are never installed (ExpoModulesCore is not a direct app
  # dependency, so the CLI never sees it either), and the Expo pod
  # then fails to compile on its first header line,
  # `#import <ExpoModulesCore/ExpoModulesCore.h>` (proven on the
  # Flight Journal Mac pilot, run #5, ~19 min into the archive).
  # With use_expo_modules!, Expo's autolinking installs Expo +
  # ExpoModulesCore + ExpoModulesJSI and every module whose podspec
  # declares macOS support, and skips the iOS-only ones — those stay
  # stubbed on the JS side by Metro, as before.
  use_expo_modules!

  use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)

    # Point ExpoModulesJSI's xcframework script phase at THIS target's
    # React Native (react-native-macos), not the app's iOS react-native.
    # The pod builds itself via a script phase (scripts/build-
    # xcframework.sh) that resolves RN_ROOT by node-resolving
    # `react-native/package.json` unless REACT_NATIVE_PATH is set as a
    # build setting (the mechanism the script itself documents, used by
    # Expo Go). Without it, RN_ROOT is the iOS react-native 0.86.3, and
    # ExpoModulesJSI's Package.swift then finds 0.86's
    # <cxxreact/ReactNativeVersion.h> while <jsi/jsi.h> comes from
    # react-native-macos 0.83's React-jsi pod. ExpoModulesJSI's
    # IRuntimeCompat.h keys its `using IRuntime = Runtime;` alias (the
    # bridge for pre-0.86 JSI) on that version header — reading 0.86
    # disables the alias, and the pod dies compiling against the 0.83
    # jsi.h, which has no IRuntime (proven failure: Flight Journal Mac
    # run #6 and Rewards Mac run #1, exit 65, ~12 min into the archive).
    # With REACT_NATIVE_PATH set to react-native-macos, the version
    # header reads 0.83, the alias fires, and the pod compiles against
    # the same JSI it links against. Scoped to this pod target and to
    # the macOS Podfile only; iOS/tvOS/Android are unaffected.
    jsi_rn_path = File.expand_path('../node_modules/react-native-macos',
                                   installer.config.installation_root)
    installer.pods_project.targets.each do |target|
      next unless target.name == 'ExpoModulesJSI'

      target.build_configurations.each do |config|
        config.build_settings['REACT_NATIVE_PATH'] = jsi_rn_path
      end
    end

    # Replace the glog modulemap CocoaPods generates for this install
    # with the textual-header modulemap React Native 0.84+ ships.
    # RN 0.86's glog.podspec declares module_map =
    # 'src/glog/module.modulemap' (written by its
    # ios-configure-glog.sh prepare command for exactly this bug);
    # the react-native-macos 0.83 fork's podspec and script predate
    # that fix and declare no module_map, so CocoaPods generates one
    # with a `module * { export * }` wildcard — which turns every
    # glog header into its own submodule (glog.glog.log_severity,
    # ...). glog's logging.h #includes log_severity.h from inside
    # `namespace google`, so when NitroModules' Swift compile loads
    # React's headers (NitroModules-umbrella.h -> ReactProp.hpp ->
    # ConcreteComponentDescriptor.h -> react_native_assert.h ->
    # <glog/logging.h>) with that modulemap passed via -Xcc, Clang
    # turns the nested include into a submodule import inside a
    # namespace — illegal — and reports "import of module
    # 'glog.glog.log_severity' appears within namespace 'google'" /
    # "could not build module 'glog'", failing the whole
    # NitroModules module build (Mac run #7, exit 65, after the
    # ExpoModulesJSI fix had already cleared the compile up to this
    # target). Declaring glog's five public headers `textual` keeps
    # them inside the single glog module — no submodules are created,
    # so the nested include stays a textual include and is legal in
    # any namespace. This is the workaround documented for this exact
    # error with react-native-nitro-modules 0.37 on RN <= 0.83
    # (margelo/nitro#1573); the header list and `export *` mirror
    # RN 0.86's shipped modulemap, with paths prefixed 'glog/' for
    # resolution from the Pods header search paths. Both locations
    # CocoaPods writes the generated modulemap to are patched (the
    # public-headers copy consumers resolve the module through, and
    # the glog target's own Target Support Files copy), each only if
    # it exists. Scoped to this macOS Podfile's Pods sandbox; the iOS
    # install uses RN 0.86's podspec, which already ships the textual
    # modulemap, and is untouched.
    glog_textual_modulemap = <<~MODULEMAP
      module glog {
        textual header "glog/log_severity.h"
        textual header "glog/logging.h"
        textual header "glog/raw_logging.h"
        textual header "glog/stl_logging.h"
        textual header "glog/vlog_is_on.h"
        export *
      }
    MODULEMAP
    [
      File.join(installer.sandbox.public_headers.root, 'glog', 'glog.modulemap'),
      File.join(installer.sandbox.root, 'Target Support Files', 'glog', 'glog.modulemap'),
    ].each do |modulemap_path|
      next unless File.exist?(modulemap_path)

      File.delete(modulemap_path)
      File.write(modulemap_path, glog_textual_modulemap)
    end

    # Add the react-native-macos fork's iostextinput header directory
    # to every pod target's HEADER_SEARCH_PATHS. React-RCTFabric's
    # RCTConversions.h (shipped inside the built RCTFabric.framework)
    # does, under '#if TARGET_OS_OSX',
    #   #import <react/renderer/components/iostextinput/primitives.h>
    # and the fork keeps that header at
    # ReactCommon/react/renderer/components/textinput/platform/ios/
    # react/renderer/components/iostextinput/primitives.h — it only
    # resolves if that platform/ios directory is on the search path.
    # Under STATIC linkage (the Flight Journal / Rewards Mac builds,
    # which have no use_frameworks!) it resolves for free: the
    # iostextinput subspec of React-FabricComponents declares
    # header_dir 'react/renderer/components/iostextinput', so
    # CocoaPods links the header into Pods/Headers/Public/react/
    # renderer/components/iostextinput/, which every pod target
    # searches. Under DYNAMIC frameworks — required on this target
    # by react-native-firebase's SPM integration (see the
    # use_frameworks! note above) — headers stay inside their own
    # .framework and that Public path is never populated;
    # react_native_post_install compensates for a fixed list of
    # framework header paths (graphics/platform/ios,
    # imagemanager/platform/ios, view/platform/cxx,
    # runtimeexecutor/platform/ios, ...) but NOT this one, so the
    # first pod target that pulls in RCTConversions.h dies:
    # "RCTConversions.h:18:9: fatal error:
    # 'react/renderer/components/iostextinput/primitives.h' file not
    # found" (macOS run #3, head d113db8, compiling
    # react-native-safe-area-context's RNCSafeAreaViewComponentView.o
    # after ~27 min of archive). The directory added here contains
    # only the react/renderer/components/iostextinput/ tree, so the
    # extra path can shadow nothing; it is appended (via the same
    # read-modify-write of build_settings that RN's own
    # update_header_paths_if_depends_on performs, preserving
    # $(inherited)) to all pod targets, since any Fabric consumer —
    # React-RCTFabric itself included — can hit the same include.
    # Scoped to this macOS Podfile's post_install only; the iOS
    # install (static RN 0.86 podspecs, no fork) is untouched.
    iostextinput_header_dir = File.expand_path(
      '../node_modules/react-native-macos/ReactCommon/react/renderer/components/textinput/platform/ios',
      installer.config.installation_root)
    quoted_iostextinput_dir = "\"#{iostextinput_header_dir}\""
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        existing_paths = config.build_settings['HEADER_SEARCH_PATHS']
        case existing_paths
        when Array
          next if existing_paths.any? { |p| p.to_s.include?(iostextinput_header_dir) }

          config.build_settings['HEADER_SEARCH_PATHS'] =
            existing_paths + [quoted_iostextinput_dir]
        when String
          next if existing_paths.include?(iostextinput_header_dir)

          config.build_settings['HEADER_SEARCH_PATHS'] =
            "#{existing_paths} #{quoted_iostextinput_dir}"
        else
          config.build_settings['HEADER_SEARCH_PATHS'] =
            "$(inherited) #{quoted_iostextinput_dir}"
        end
      end
    end

    # Add the react-native-macos fork's ReactCommon root to every
    # pod target's HEADER_SEARCH_PATHS — the general form of the
    # iostextinput fix above. The block above made
    # <react/renderer/components/iostextinput/primitives.h> itself
    # resolve, but that header's line 10 does
    #   #include <react/renderer/components/textinput/basePrimitives.h>
    # and basePrimitives.h lives at ReactCommon/react/renderer/
    # components/textinput/basePrimitives.h — reachable only if a
    # search path ends at the ReactCommon root, so the full
    # react/renderer/... prefix resolves against the source tree.
    # Under STATIC linkage (Flight Journal / Rewards) that prefix
    # resolves for free through Pods/Headers/Public/React-Core,
    # which symlinks the ReactCommon tree; under this target's
    # DYNAMIC frameworks it is never populated, so the compiler
    # reports the header "not found in framework 'react'"
    # (React-Core.framework). macOS run #4 (head 4b76a23) proved the
    # point: with the iostextinput fix in, the archive ran ~12
    # minutes past the old failure and died at 27m44s compiling
    # react-native-safe-area-context's
    # RNCSafeAreaViewComponentView.mm (RCTConversions.h ->
    # iostextinput primitives.h -> basePrimitives.h) on exactly
    # this include. Renderer headers cross-include each other by
    # this prefix throughout the tree (components, core, graphics,
    # ...), so chasing them one directory per ~30-minute run is
    # untenable; exposing the fork's ReactCommon root restores
    # precisely the header visibility the static install has, for
    # every pod target, using the same read-modify-write loop as
    # the block above. The path can shadow nothing foreign: every
    # header under it is the fork's own source, the same source the
    # frameworks in this install were built from. Scoped to this
    # macOS Podfile's post_install only; the iOS install (RN 0.86,
    # whose podspecs populate the Public tree) is untouched.
    react_common_dir = File.expand_path(
      '../node_modules/react-native-macos/ReactCommon',
      installer.config.installation_root)
    quoted_react_common_dir = "\"#{react_common_dir}\""
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        existing_paths = config.build_settings['HEADER_SEARCH_PATHS']
        case existing_paths
        when Array
          next if existing_paths.any? { |p| p.to_s.include?(react_common_dir) }

          config.build_settings['HEADER_SEARCH_PATHS'] =
            existing_paths + [quoted_react_common_dir]
        when String
          next if existing_paths.include?(react_common_dir)

          config.build_settings['HEADER_SEARCH_PATHS'] =
            "#{existing_paths} #{quoted_react_common_dir}"
        else
          config.build_settings['HEADER_SEARCH_PATHS'] =
            "$(inherited) #{quoted_react_common_dir}"
        end
      end
    end

    # Trim react-native-reanimated 4.8.0's Fabric prop tables to
    # the PropName members the react-native-macos 0.83 fork
    # actually defines. Reanimated 4.8 targets RN 0.86, whose
    # react/renderer/animationbackend/AnimatedProps.h declares a
    # 52-member facebook::react::PropName enum; the fork's
    # AnimatedProps.h declares exactly six:
    #   OPACITY, WIDTH, HEIGHT, BORDER_RADII, FLEX, TRANSFORM
    # Two reanimated headers name the other 46:
    #   - Fabric/updates/propNameFromString.h — a 103-entry map
    #     from JS prop names to PropName values (only the 18
    #     entries naming the six fork members can compile);
    #   - Fabric/updates/PropsLayoutFilter.h — the 29-entry
    #     layoutPropNames set used by isLayoutProp() (only WIDTH,
    #     HEIGHT, FLEX survive).
    # Both headers are compiled by this Mac build:
    # RNReanimated.podspec's "common" subspec globs
    # Common/cpp/reanimated/**/*.{cpp,h} unconditionally, and
    # UpdatesRegistry.cpp includes PropsLayoutFilter.h, which
    # includes propNameFromString.h. Left alone, the archive dies
    # on the first missing enumerator — the same failure that
    # already killed a SimDeck Mac run. The patch below edits the
    # two node_modules files in place (CI starts from a fresh
    # `npm ci` each run and this hook reapplies the patch on every
    # macOS pod install), dropping exactly the entries that name
    # members the fork lacks. Runtime cost on macOS is nil for
    # PropsLayoutFilter (shouldFilterNonLayoutProps() is
    # Android-only; the set is never consulted on Apple platforms)
    # and cosmetic for the map (a layout/animation prop outside
    # the six simply misses reanimated's animated-props fast path
    # on Mac). Like the SimDeck RNSVGImage patch (6e2ff66), this
    # RAISES at pod install if a file's shape has changed —
    # verified by re-scanning the patched text for any surviving
    # reference to a member outside the fork's six — rather than
    # failing silently ~30 minutes into an archive. Idempotent:
    # an already-trimmed file verifies clean and is left alone.
    # Scoped to this macOS Podfile's post_install only; iOS/tvOS
    # installs never run it and keep the full tables against
    # RN 0.86's complete enum.
    reanimated_fork_prop_names = %w[OPACITY WIDTH HEIGHT BORDER_RADII FLEX TRANSFORM].freeze
    reanimated_member_ref = /facebook::react::([A-Z][A-Z_0-9]*)\b/
    reanimated_updates_dir = File.expand_path(
      '../node_modules/react-native-reanimated/Common/cpp/reanimated/Fabric/updates',
      installer.config.installation_root)

    prop_name_from_string_h = File.join(reanimated_updates_dir,
                                        'propNameFromString.h')
    if File.exist?(prop_name_from_string_h)
      contents = File.read(prop_name_from_string_h)
      referenced = contents.scan(reanimated_member_ref).flatten.uniq
      unless (referenced - reanimated_fork_prop_names).empty?
        patched = contents.lines.reject do |line|
          entry = line.match(/\{"[^"]+",\s*facebook::react::([A-Z][A-Z_0-9]*)\}/)
          entry && !reanimated_fork_prop_names.include?(entry[1])
        end.join
        surviving = patched.scan(reanimated_member_ref).flatten.uniq -
                    reanimated_fork_prop_names
        unless surviving.empty?
          raise 'propNameFromString.h: references to PropName members ' \
                "#{surviving.join(', ')} survive the macOS trim — the " \
                'file format has changed; re-check the Mac patch in ' \
                'macos/Podfile.'
        end
        unless patched.include?('propNameFromString') &&
               patched.include?('propNameMap') &&
               reanimated_fork_prop_names.all? do |member|
                 patched.include?("facebook::react::#{member}")
               end
          raise 'propNameFromString.h: the macOS trim damaged the ' \
                'propNameMap — re-check the Mac patch in macos/Podfile.'
        end

        File.write(prop_name_from_string_h, patched)
      end
    end

    props_layout_filter_h = File.join(reanimated_updates_dir,
                                      'PropsLayoutFilter.h')
    if File.exist?(props_layout_filter_h)
      contents = File.read(props_layout_filter_h)
      referenced = contents.scan(reanimated_member_ref).flatten.uniq
      unless (referenced - reanimated_fork_prop_names).empty?
        set_match = contents.match(
          /(static const std::set<facebook::react::PropName> layoutPropNames = \{)(.*?)(\n\s*\};)/m)
        unless set_match
          raise 'PropsLayoutFilter.h: could not find the ' \
                'layoutPropNames set — the file format has changed; ' \
                're-check the Mac patch in macos/Podfile.'
        end

        kept_members = set_match[2].scan(reanimated_member_ref).flatten
                                   .select do |member|
                                     reanimated_fork_prop_names.include?(member)
                                   end
        if kept_members.empty?
          raise 'PropsLayoutFilter.h: no layoutPropNames entries ' \
                'survive the fork PropName trim — re-check the Mac ' \
                'patch in macos/Podfile.'
        end

        rebuilt_set = "#{set_match[1]}\n      " \
                      "#{kept_members.map { |m| "facebook::react::#{m}" }.join(', ')}," \
                      "#{set_match[3]}"
        patched = contents.sub(set_match[0]) { rebuilt_set }
        surviving = patched.scan(reanimated_member_ref).flatten.uniq -
                    reanimated_fork_prop_names
        unless surviving.empty?
          raise 'PropsLayoutFilter.h: references to PropName members ' \
                "#{surviving.join(', ')} survive the macOS trim — " \
                'the file format has changed; re-check the Mac patch ' \
                'in macos/Podfile.'
        end

        File.write(props_layout_filter_h, patched)
      end
    end
  end
end
